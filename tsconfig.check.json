{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node", "vscode"],
    "noEmit": true
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts",
    "plugins/*/src/**/*.ts",
    "scripts/**/*.ts"
  ],
  "exclude": [
    "packages/*/test/scratch/**"
  ]
}
