{
  "name": "vsc-cordis",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cordis-style plugin runtime (effect stack + reactive DI) running on top of the VSCode extension host",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test \"packages/*/test/*.spec.ts\"",
    "typecheck": "tsc -p tsconfig.check.json",
    "build": "node scripts/build.mjs",
    "build:prod": "node scripts/build.mjs --production",
    "watch": "node scripts/watch.mjs",
    "keygen": "node scripts/gen-key.mjs",
    "sign": "node scripts/sign-plugin.mjs",
    "smoke": "node scripts/smoke-built-plugins.mjs",
    "verify": "npm run typecheck && npm run test && npm run build && npm run smoke"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/vscode": "~1.95.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.2"
  }
}
