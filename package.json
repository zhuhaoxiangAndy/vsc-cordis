{
  "name": "vsc-cordis",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cordis-style plugin runtime (effect stack + reactive DI) running on top of the VSCode extension host",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test \"packages/*/test/*.spec.ts\"",
    "typecheck": "tsc -p tsconfig.check.json",
    "check:docs": "node scripts/check-doc-links.mjs",
    "build": "node scripts/build.mjs",
    "build:prod": "node scripts/build.mjs --production",
    "watch": "node scripts/watch.mjs",
    "keygen": "node scripts/gen-key.mjs",
    "sign": "node scripts/sign-plugin.mjs",
    "cli": "node packages/cli/src/bin.ts",
    "tree": "node packages/cli/src/bin.ts tree",
    "list": "node packages/cli/src/bin.ts list",
    "smoke": "node scripts/smoke-built-plugins.mjs",
    "package": "cd packages/host && vsce package --no-dependencies --out ../../vscordis-local.vsix",
    "verify:package": "node scripts/verify-vsix.mjs",
    "verify:release": "npm run build:prod && npm run package && npm run verify:package",
    "verify": "npm run typecheck && npm run test && npm run check:docs && npm run build && npm run smoke"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/vscode": "~1.95.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.2"
  }
}
